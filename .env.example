# Phase E1 (docs/decisions/ADR-003-llm-agent-system-is-product-core.md).
# Non-secret configuration only -- Ollama requires no API key, so there is
# nothing sensitive in this file. Copy to .env (gitignored) and adjust if
# your local Ollama daemon isn't on the default port.

# Base URL of the local Ollama server. Defaults to this value in code
# (backend/src/chronicle/ai/models/ollama.py) if unset -- setting it here
# is only needed if your Ollama instance runs somewhere else.
CHRONICLE_OLLAMA_BASE_URL=http://localhost:11434
